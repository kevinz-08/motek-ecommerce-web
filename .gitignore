apps/api/dist/

# production
build
dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for committing if needed)
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client (regenerated via pnpm --filter @motek/database generate)
packages/database/src/generated/

# compiled JS artifacts that land next to TS source (e.g. from stray tsc runs)
packages/*/src/**/*.js
packages/*/src/**/*.d.ts

# assets de trabajo locales (fotos de productos sin procesar, etc.)
tmp-productos/
apps/web/tmp-productos/

# exports de Optimun (inventario real del negocio — nunca al repo)
*.xlsx
*.csv

# .md para opencode y claude code
BACKLOG.md*
AUDITORIA.md*
