# Base de datos (Neon PostgreSQL)
DATABASE_URL=
# Máximo de conexiones del pool pg.Pool por proceso (default 5).
# En Vercel serverless cada función tiene su propio proceso — mantén esto bajo (3-5).
# Si usas el pooler nativo de Neon, añade ?pgbouncer=true a DATABASE_URL y baja esto a 1.
DATABASE_POOL_MAX=5

# NextAuth.js
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# URL del API NestJS (usada por NextAuth y server components para llamadas server-side)
API_URL=http://localhost:3001

# Secret compartido entre apps/web y apps/api para el endpoint POST /auth/session-token.
# Debe ser idéntico al INTERNAL_API_SECRET de apps/api. Mínimo 32 caracteres.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_SECRET=

# Google OAuth (para NextAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Wompi (pasarela principal — Colombia)
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# "sandbox" en desarrollo, "production" en producción
WOMPI_ENV=sandbox

# Resend (emails transaccionales)
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@motekstore.com

# Cloudinary (imágenes de productos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WhatsApp (formato: código de país + número, sin +, sin espacios ni guiones)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Observabilidad (Sentry — @sentry/nextjs instalado)
# NEXT_PUBLIC_ porque el DSN se usa en cliente y servidor.
# El DSN no es un secreto: se incluye en el bundle del cliente por diseño.
# Obtener en: https://sentry.io → Settings → Projects → <proyecto> → Client Keys
NEXT_PUBLIC_SENTRY_DSN=
# Para upload de source maps (stack traces legibles en producción):
# SENTRY_AUTH_TOKEN=   ← generar en Sentry → Settings → Auth Tokens
# SENTRY_ORG=          ← slug de tu organización en Sentry
# SENTRY_PROJECT=      ← nombre del proyecto en Sentry

# ── Cloudflare Turnstile (captcha del checkout de invitado) ───────────────────
# Site key pública — va en el bundle del cliente por diseño; el secreto vive en
# la API (TURNSTILE_SECRET_KEY) y es quien realmente valida el token.
#
# Si falta, el checkout de invitado no se ofrece: el formulario muestra el CTA de
# iniciar sesión en su lugar (mejor eso que un botón deshabilitado sin explicación).
#
# Obtener en: https://dash.cloudflare.com → Turnstile → Add site
# Clave de PRUEBA que siempre aprueba (para E2E/local): 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
