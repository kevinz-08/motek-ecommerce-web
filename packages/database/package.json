{
  "name": "@motek/database",
  "version": "0.0.0",
  "private": true,
  "description": "Cliente Prisma centralizado + schema + migraciones + seeds. Única fuente de verdad de acceso a datos del monorepo.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "catalog": "tsx prisma/catalog.ts",
    "moto-compat": "tsx prisma/seed-motorcycle-compatibility.ts",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"(no lint for @motek/database yet)\""
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "pg": "^8.20.0",
    "prisma": "^7.7.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "bcryptjs": "^3.0.3",
    "@types/bcryptjs": "^2.4.6",
    "dotenv": "^16.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  },
  "prisma": {
    "schema": "./prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  }
}
